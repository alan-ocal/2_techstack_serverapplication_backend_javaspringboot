<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="library_persistence_unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Field</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Category</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Book</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Author</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Review</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.User</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Group</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Payment</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.CashPayment</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.CardPayment</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Item</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Fiction</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.NonFiction</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Student</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Teacher</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Student2</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Teacher2</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Member2</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.Genre</class>
        <class>com.example.linkedinsamarakkody.jakarta.entities.BookType</class>

        <properties>
            <!-- MariaDB Connection Settings -->
            <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/library"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="Elbasit99!"/>
            <property name="hibernate.show_sql" value="true"/>
            <!--added for inheritance-->
            <property name="hibernate.hbm2ddl.auto" value="create"/>

        </properties>
    </persistence-unit>
</persistence>
